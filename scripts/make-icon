#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "usage: $0 [path/to/icon.svg]" >&2
    exit 2
}

[ "$#" -le 1 ] || usage

# Work from the repo root regardless of the current directory.
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo"

svg="${1:-assets/icon/oriel.svg}"
if [ ! -f "$svg" ]; then
    echo "error: $svg not found" >&2
    exit 1
fi
out="assets/icon/Oriel.icns"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# Tiny renderer: AppKit draws the SVG (keeps transparency and gradients) into a PNG.
# SVG filters are not supported by this renderer, so the SVG must not use them.
cat > "$work/render.swift" <<'SWIFT'
import AppKit
let a = CommandLine.arguments
guard a.count == 4, let img = NSImage(contentsOfFile: a[1]), let px = Int(a[3]) else {
    FileHandle.standardError.write(Data("render: bad arguments or unreadable SVG\n".utf8))
    exit(1)
}
let rep = NSBitmapImageRep(bitmapDataPlanes: nil, pixelsWide: px, pixelsHigh: px, bitsPerSample: 8,
    samplesPerPixel: 4, hasAlpha: true, isPlanar: false, colorSpaceName: .deviceRGB,
    bytesPerRow: 0, bitsPerPixel: 0)!
NSGraphicsContext.saveGraphicsState()
NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: rep)
NSGraphicsContext.current?.imageInterpolation = .high
img.draw(in: NSRect(x: 0, y: 0, width: px, height: px), from: .zero, operation: .copy, fraction: 1)
NSGraphicsContext.restoreGraphicsState()
try! rep.representation(using: .png, properties: [:])!.write(to: URL(fileURLWithPath: a[2]))
SWIFT

# Some Command Line Tools installs have an SDK newer than the compiler; prefer a matching one.
if [ -z "${SDKROOT:-}" ]; then
    for sdk in /Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk; do
        [ -d "$sdk" ] && export SDKROOT="$sdk"
    done
fi
swiftc -O "$work/render.swift" -o "$work/render"

iconset="$work/Oriel.iconset"
mkdir -p "$iconset"
for size in 16 32 128 256 512; do
    "$work/render" "$svg" "$iconset/icon_${size}x${size}.png" "$size"
    "$work/render" "$svg" "$iconset/icon_${size}x${size}@2x.png" "$((size * 2))"
done

iconutil -c icns "$iconset" -o "$out"
echo "Icon: $repo/$out (from $svg)"
